<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dual_ur3e_description</name>
  <version>0.0.1</version>
  <description>Dual UR3e robot with Robotiq grippers for teleoperation challenge</description>
  <maintainer email="lirunmo0919@gmail.com">cnbot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- Depends on already-downloaded packages -->
  <depend>ur_description</depend>
  <depend>robotiq_85_description</depend>
  
  <!-- Core ROS 2 dependencies -->
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>rviz2</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
