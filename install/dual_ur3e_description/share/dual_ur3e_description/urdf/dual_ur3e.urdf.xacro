<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="dual_arm_robot">
  <!-- Import Xacro macros -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find robotiq_85_description)/urdf/robotiq_85_gripper_macro.urdf.xacro"/>
  <!-- World frame -->
  <link name="world"/>
  <!-- Base table - 1.1m x 0.5m  -->
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0.55 0.25 0" rpy="0 0 0"/>
  </joint>
  <link name="table_link">
    <visual>
      <origin xyz="0 0 0.75" rpy="0 0 0"/>
      <geometry>
        <box size="1.1 0.5 0.05"/>
      </geometry>
      <material name="table_material">
        <color rgba="0.9 0.8 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.75" rpy="0 0 0"/>
      <geometry>
        <box size="1.1 0.5 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10"/>
      <origin xyz="0 0 0.75" rpy="0 0 0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="1" iyz="0" izz="1.5"/>
    </inertial>
  </link>
  <!-- Left arm base mount - 位于 (-0.5, 0)，保持末端朝向 -X -->
  <joint name="table_to_left_base" type="fixed">
    <parent link="table_link"/>
    <child link="left_base_mount"/>
    <origin xyz="-0.5 0 0.775" rpy="0 0 -1.5708"/>
  </joint>
  <link name="left_base_mount">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.02"/>
      </geometry>
      <material name="base_material">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <!-- Right arm base mount - 位于 (0.5, 0)，保持末端朝向 +X -->
  <joint name="table_to_right_base" type="fixed">
    <parent link="table_link"/>
    <child link="right_base_mount"/>
    <origin xyz="0.5 0 0.775" rpy="0 0 1.5708"/>
  </joint>
  <link name="right_base_mount">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.02"/>
      </geometry>
      <material name="base_material">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <!-- Left UR5 arm -->
  <xacro:ur_robot
    name="left_ur5"
    tf_prefix="left_"
    parent="right_base_mount"
    joint_limits_parameters_file="$(find ur_description)/config/ur5/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5/visual_parameters.yaml"
    safety_limits="false"
    safety_pos_margin="0.15"
    safety_k_position="20">
    <origin xyz="0 0 0.02" rpy="0 0 -1.5708"/>
  </xacro:ur_robot>
  <!-- Right UR5 arm -->
  <xacro:ur_robot
    name="right_ur5"
    tf_prefix="right_"
    parent="left_base_mount"
    joint_limits_parameters_file="$(find ur_description)/config/ur5/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5/visual_parameters.yaml"
    safety_limits="false"
    safety_pos_margin="0.15"
    safety_k_position="20">
    <origin xyz="0 0 0.02" rpy="0 0 -1.5708"/>
  </xacro:ur_robot>
  <!-- Left arm robotiq gripper -->
  <xacro:robotiq_85_gripper 
    prefix="left_"
    parent="left_tool0"
    sim="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_85_gripper>
  <!-- Right arm robotiq gripper -->
  <xacro:robotiq_85_gripper 
    prefix="right_"
    parent="right_tool0"
    sim="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_85_gripper>
</robot>