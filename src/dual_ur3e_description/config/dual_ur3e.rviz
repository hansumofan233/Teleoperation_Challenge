    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        world:
          base_platform:
            {}
          left_base_link:
            {}
          gripper_root_link:
            {}
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive: true
    - Class: rviz_default_plugins/MoveCamera
      Hide Inactive: true
    - Class: rviz_default_plugins/Select
      Hide Inactive: true
    - Class: rviz_default_plugins/FocusCamera
      Hide Inactive: true
    - Class: rviz_default_plugins/Measure
      Hide Inactive: true
    - Class: rviz_default_plugins/ClassicMeasure
      Hide Inactive: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.785
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.785
    Saved Views: {}
  Window Geometry:
    Displays:
      collapsed: false
      height: 1716
      width: 1200
    Selection:
      collapsed: false
      height: 246
      width: 1920
    Tool Properties:
      collapsed: false
      height: 0
      width: 400
    Views:
      collapsed: false
      height: 1716
      width: 720
    "":
      collapsed: false
