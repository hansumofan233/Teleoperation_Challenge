<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_ur3e_with_grippers">
  <!-- 导入UR宏定义（不是主文件） -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  
  <!-- 导入Robotiq夹爪宏定义 -->
  <xacro:include filename="$(find robotiq_85_description)/urdf/robotiq_85_gripper.urdf.xacro"/>
  
  <!-- 基座平台 -->
  <link name="base_platform">
    <visual>
      <geometry>
        <box size="2.0 1.5 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="2.0 1.5 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="100"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="10" iyz="0" izz="10"/>
    </inertial>
  </link>
  <!-- 左臂UR3e - 自动创建world并连接到它 -->
  <xacro:ur_robot
    name="left_arm"
    tf_prefix="left_"
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur3e/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur3e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur3e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur3e/visual_parameters.yaml"
    transmission_hw_interface=""
    safety_limits="false"
    safety_pos_margin="0.15"
    safety_k_position="20">
    <origin xyz="-0.5 0.3 0.05" rpy="0 0 0"/>
  </xacro:ur_robot>
  <!-- 将基座平台连接到world（由左臂创建） -->
  <joint name="world_to_platform" type="fixed">
    <parent link="world"/>
    <child link="base_platform"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <!-- 右臂UR3e - 连接到基座平台而不是world -->
  <xacro:ur_robot
    name="right_arm"
    tf_prefix="right_"
    parent="base_platform"
    joint_limits_parameters_file="$(find ur_description)/config/ur3e/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur3e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur3e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur3e/visual_parameters.yaml"
    transmission_hw_interface=""
    safety_limits="false"
    safety_pos_margin="0.15"
    safety_k_position="20">
    <origin xyz="-0.5 -0.3 0.05" rpy="0 0 0"/>
  </xacro:ur_robot>
  <!-- 左臂夹爪 -->
  <xacro:robotiq_85_gripper prefix="left_gripper_" parent="left_tool0">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_85_gripper>
  <!-- 右臂夹爪 -->
  <xacro:robotiq_85_gripper prefix="right_gripper_" parent="right_tool0">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_85_gripper>
</robot>